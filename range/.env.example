# ==============================================================================
# compose-multiservice-app — environment configuration
# ==============================================================================
# 1. Copy this file to .env:   cp .env.example .env
# 2. Fill in real values (safe defaults are provided for local development).
# 3. Never commit .env — it's already listed in .gitignore.
#
# IMPORTANT: every variable below must have SOME value, even for local dev.
# Docker Compose passes an unset variable through to containers as an EMPTY
# STRING rather than omitting it — this doesn't fail cleanly, it crashes the
# API at startup with a confusing error. If a container exits immediately,
# run `docker compose logs api` and check nothing below is left blank.
# ==============================================================================

# ---- Compose profile ---------------------------------------------------------
# The "range" profile makes this compose file opt-in when included by a future
# root-level Bantis orchestrator (M3+). Locally, COMPOSE_PROFILES=range below
# activates it automatically so `docker compose up` keeps working exactly as
# before — you don't need to pass --profile range by hand.
COMPOSE_PROFILES=range

# ---- PostgreSQL --------------------------------------------------------------
# These three values are used by the official postgres image to create the
# user and database automatically on first start. This only happens ONCE, on
# an empty data volume — see "Database setup" in README.md if you change
# these after the volume already exists (you'll need `docker compose down -v`
# to apply the change).
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app_db

# Used by the API to connect to PostgreSQL above. The user, password, and db
# name here MUST exactly match the three values above — mismatches here are
# the most common source of connection errors. "db" is the compose service
# name (not localhost), and 5432 is Postgres's default internal port.
DATABASE_URL=postgresql+asyncpg://app_user:change_me@db:5432/app_db

# ---- JWT authentication -------------------------------------------------------
# Generate a real secret locally instead of using the placeholder below:
#   openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO

# ---- Nginx reverse proxy ---------------------------------------------------------
# The host port nginx listens on. The API itself is no longer reachable
# directly from outside Docker — all traffic goes through nginx now.
NGINX_PORT=80

# ---- Redis cache ----------------------------------------------------------------
# "redis" below is the compose service name, same rule as "db" above.
# REDIS_PASSWORD must match the password embedded in REDIS_URL below —
# same "keep both in sync" rule as DATABASE_URL and its POSTGRES_* values.
REDIS_PASSWORD=change_this_too
REDIS_URL=redis://:change_this_too@redis:6379/0
CACHE_TTL_SECONDS=60
