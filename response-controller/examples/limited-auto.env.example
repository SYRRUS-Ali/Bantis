# Load from response-controller/: source examples/limited-auto.env.example
# Replace both repository values with the same operator-approved repository.
export RESPONSE_ENABLED_ACTIONS=hold_promotion,lift_promotion_hold
export RESPONSE_AUTO_ACTION=hold_promotion
export RESPONSE_AUTO_REPO=example-org/example-repository
export RESPONSE_GITHUB_REPO=example-org/example-repository
export RESPONSE_AUTO_POLICY_RULE=A3:composite-success
export RESPONSE_AUTO_MAX_PER_HOUR=1
export RESPONSE_DRY_RUN=true

# Set BANTIS_STATE_DIR to the existing controller state directory.
# Supply RESPONSE_GITHUB_TOKEN_PROMOTION separately; never put credentials here.
# Live execution requires an explicit RESPONSE_DRY_RUN=false after reviewing a dry run.